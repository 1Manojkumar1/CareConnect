# ─── CareConnect backend · environment template ─────────────────────────────
# Copy to .env for local development. NEVER commit .env (see .gitignore).
# For production (Render), set these in the Render Dashboard → Environment
# instead of uploading this file. See docs/DEPLOYMENT.md for the full guide.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | production
PORT=5000                       # Render injects its own PORT — do not hardcode it there

# --- Database (REQUIRED in production) -------------------------------------
# Local dev default: mongodb://127.0.0.1:27017/careconnect
# Production: MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/careconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/careconnect

# --- Auth (REQUIRED in production) -----------------------------------------
# Production: random string, min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (Render can also generate it: use "Generate Random Value" in the dashboard.)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Frontend origins / CORS (REQUIRED in production) ----------------------
# Comma-separated allowlist of exact origins (no trailing slash).
# Production example:
# CLIENT_URLS=https://careconnect.vercel.app,https://www.careconnect.example.com
# CLIENT_URL is the legacy single-origin fallback (local dev default below).
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://careconnect.vercel.app
# Optional https suffix allowlist for preview deployments (comma-separated),
# e.g. ".vercel.app" allows https://careconnect-git-main-acme.vercel.app.
# CLIENT_URL_SUFFIXES=.vercel.app

# --- AI classification (optional — heuristic fallback is used without a key)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=10000
# AI_CONFIDENCE_THRESHOLD=0.55

# --- Email / notifications (optional — notifications persist in-app regardless)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=

# --- File storage (optional — metadata is stored in MongoDB regardless) ----
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
