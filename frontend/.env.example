# ─── CareConnect frontend · environment template ────────────────────────────
# Copy to .env for local development. NEVER commit .env (see .gitignore).
# For production (Vercel), set these in the Vercel Dashboard → Project →
# Settings → Environment Variables instead. See docs/DEPLOYMENT.md.

# Local API base (must end with /api/v1)
VITE_API_URL=http://localhost:5000/api/v1
